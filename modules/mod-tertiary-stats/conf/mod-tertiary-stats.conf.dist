#
# mod-tertiary-stats
#
# The client and server must use the matching DBC patch generated by
# tools/build-wow-client-patch.py. Item tooltips display native point budgets.
# Equipped totals are converted with the character-level melee-haste rating
# cost, then multiplied by active percentage effects that modify all stats.
# Each power's Base and PerPoint settings are applied once afterward.
# Rebuild the patch after changing user-facing durations or thresholds so
# aura and item tooltips continue to match gameplay.
#

[worldserver]

########################################
# TertiaryStats.Enable
#   Enables new rolls and all equipped tertiary effects.
#   Default: 1

TertiaryStats.Enable = 1

########################################
# Cascading item rolls
#   PowerChance is checked once for each of the three possible slots and stops
#   at the first failure. At 70%, eligible items have 70% odds of at least one
#   power, 49% odds of at least two, and 34.3% odds of all three.

TertiaryStats.Roll.PowerChance = 70

# Chance that each successful power slot draws from the ordinary pool.
# The exotic pool is the remainder. Powers never repeat on the same item.
TertiaryStats.Roll.OrdinaryChance = 70

# Relative weights inside the ordinary or exotic pool. Zero disables a power
# on newly rolled items without disabling existing items that carry it.
TertiaryStats.Roll.Weight.Avoidance = 1
TertiaryStats.Roll.Weight.Fleetfoot = 1
TertiaryStats.Roll.Weight.Siphon = 1
TertiaryStats.Roll.Weight.Tempo = 1
TertiaryStats.Roll.Weight.Echo = 1
TertiaryStats.Roll.Weight.Unbroken = 1
TertiaryStats.Roll.Weight.Opportunity = 1

########################################
# Eligibility
#   Item quality values: 0 poor, 1 common, 2 uncommon, 3 rare, 4 epic,
#   5 legendary, 6 artifact, 7 heirloom.
#   Weapons and armor only. Native random properties and suffixes coexist with
#   tertiary bonuses. Bags, shirts, tabards, quivers, relics, non-equipment,
#   and stackable items are excluded.

TertiaryStats.Eligibility.MinQuality = 2
TertiaryStats.Eligibility.MaxQuality = 4
TertiaryStats.Eligibility.MinItemLevel = 1

########################################
# Ordinary powers
#   B = total equipped native points / level-scaled rating cost, multiplied
#   by active percentage buffs and debuffs that modify every stat.
#   Heirloom native points use the wearer's level and the item's native scaling
#   budget profile; custom heirlooms infer that profile from their equipment slot.
#   Avoidance = B * PerPoint.
#   Fleetfoot and Siphon = Base + B * PerPoint when B is nonzero. Siphon
#   responds to effective damage and effective healing by the player or pets.

TertiaryStats.Value.AvoidancePerPoint = 0.5
TertiaryStats.Value.FleetfootBase = 15
TertiaryStats.Value.FleetfootPerPoint = 1.1
TertiaryStats.Value.SiphonBase = 1
TertiaryStats.Value.SiphonPerPoint = 0.2

########################################
# Tempo
#   Speed, PPM, and cooldown reduction each use Base + B * PerPoint. Speed
#   also accelerates ticks from damaging area effects owned by the player.
#   Each proc refreshes separate eight-second speed and cooldown-charge auras.
#   The first non-triggered class ability with a native effective cooldown in
#   the inclusive MinCooldownMs-MaxCooldownMs range consumes the charge.
#   Shared spell-category cooldowns are reduced together.

TertiaryStats.Value.TempoSpeedBase = 5
TertiaryStats.Value.TempoSpeedPerPoint = 1.2
TertiaryStats.Value.TempoPPMBase = 3
TertiaryStats.Value.TempoPPMPerPoint = 0.075
TertiaryStats.Value.TempoCooldownBaseMs = 1000
TertiaryStats.Value.TempoCooldownPerPointMs = 100
TertiaryStats.Tempo.DurationMs = 8000
TertiaryStats.Tempo.MinCooldownMs = 3000
TertiaryStats.Tempo.MaxCooldownMs = 30000

########################################
# Echo
#   Percent and PPM each use Base + B * PerPoint. A proc stores effective
#   native and tertiary damage and healing for DurationMs. Tertiary outputs
#   can be stored but cannot initiate proc chains. At expiry, stored damage is
#   divided among engaged enemies near the current/last hostile target;
#   stored healing is assigned to the most injured nearby raid members.

TertiaryStats.Value.EchoPercentBase = 4
TertiaryStats.Value.EchoPercentPerPoint = 0.46
TertiaryStats.Value.EchoPPMBase = 2
TertiaryStats.Value.EchoPPMPerPoint = 0.05
TertiaryStats.Echo.DurationMs = 6000
TertiaryStats.Echo.DamageRadius = 10
TertiaryStats.Echo.HealingRadius = 30

########################################
# Unbroken
#   Shield = ShieldBase + B * ShieldPerPoint. Total healing and movement speed
#   equal B * PerPoint. A nonlethal hit crossing ThresholdPct or an applied
#   Daze triggers the six-second package. HealingPercent is total healing
#   across the duration, not per tick. Items carrying Unbroken individually
#   ignore durability loss.

TertiaryStats.Value.UnbrokenShieldBase = 10
TertiaryStats.Value.UnbrokenShieldPerPoint = 0.25
TertiaryStats.Value.UnbrokenHealingPerPoint = 0.5
TertiaryStats.Value.UnbrokenSpeedPerPoint = 2
TertiaryStats.Unbroken.ThresholdPct = 35
TertiaryStats.Unbroken.DurationMs = 6000
TertiaryStats.Unbroken.CooldownMs = 45000

########################################
# Opportunity
#   PPM = Base + B * PerPoint when B is nonzero. The proc is stored for
#   DurationMs. The next eligible cast guarantees criticals for every immediate
#   target and every tick of an active channel. Attached or independently
#   persistent DoT/HoT ticks are not empowered. Auto-attacks and triggered/item/
#   profession spells do not consume Opportunity.

TertiaryStats.Value.OpportunityPPMBase = 0.5
TertiaryStats.Value.OpportunityPPMPerPoint = 0.225
TertiaryStats.Opportunity.DurationMs = 8000

########################################
# Fabled
#   Rule-changing effects rolled as a regular tertiary outcome. An item that
#   wins its first PowerChance roll has Fabled.Chance multiplied by its quality
#   multiplier odds of becoming fabled instead of rolling stat powers.
#   Head, chest, legs, feet, and back each have one utility effect; weapons
#   have Overkill. Rings roll Crossfire, Momentum, Warcaster, or Blood Magic.
#   Trinkets roll Premonition, Vengeful Ghost, Alchemist's Gut, or Indomitable.
#   Other item types roll ordinary powers.

TertiaryStats.Fabled.Chance = 2
TertiaryStats.Fabled.ChanceMultiplier.Uncommon = 1
TertiaryStats.Fabled.ChanceMultiplier.Rare = 2
TertiaryStats.Fabled.ChanceMultiplier.Epic = 4

# Reforging consumes a Fabled source item and transfers its effect to a
# compatible non-Fabled bag item. The destination becomes soulbound and loses
# any ordinary tertiary bonus. Cost is the destination's vendor price multiplied
# by VendorMultiplier and clamped to this copper range.
TertiaryStats.Fabled.Reforge.Enable = 1
TertiaryStats.Fabled.Reforge.VendorMultiplier = 5
TertiaryStats.Fabled.Reforge.MinCostCopper = 10000
TertiaryStats.Fabled.Reforge.MaxCostCopper = 1000000

# Impact: fall damage becomes an AoE hit around your landing point.
TertiaryStats.Fabled.Impact.RadiusYd = 20

# Premonition: XP-eligible killing blows open a zero-cost ability window.
TertiaryStats.Fabled.Premonition.WindowMs = 4000

# Momentum: kills add move/attack/cast speed stacks on one shared timer.
TertiaryStats.Fabled.Momentum.PctPerStack = 1
TertiaryStats.Fabled.Momentum.MaxStacks = 40
TertiaryStats.Fabled.Momentum.WindowMs = 15000

# Ghostwalk: out of combat you fade into a fast spirit; any player cast ends it.
TertiaryStats.Fabled.Ghostwalk.DelayMs = 6000
TertiaryStats.Fabled.Ghostwalk.SpeedPct = 40

# Keeper: metadata-defined elixir, flask, Well Fed, and scroll timers pause
# while equipped and resume when Keeper is unequipped or the player dies.
# ExtraSpells is an explicit comma-separated override for custom server spells.
TertiaryStats.Fabled.Keeper.ScanIntervalMs = 2000
TertiaryStats.Fabled.Keeper.ExtraSpells = ""

# Vengeful Ghost: the killing blow leaves you at 1 HP in a spirit phase;
# land a kill inside the phase to snap back at ResHealthPct.
TertiaryStats.Fabled.VengefulGhost.PhaseMs = 10000
TertiaryStats.Fabled.VengefulGhost.LockoutMs = 600000
TertiaryStats.Fabled.VengefulGhost.ResHealthPct = 30

# Crossfire: direct damage strikes your previous target using the source school.
TertiaryStats.Fabled.Crossfire.Pct = 30
TertiaryStats.Fabled.Crossfire.RangeYd = 40

# Alchemist's Gut: potions have no cooldown; each drink adds a Toxicity
# stack ticking PctPerTick percent of max health per 3 seconds. Lethal.
TertiaryStats.Fabled.AlchemistsGut.PctPerTick = 5
TertiaryStats.Fabled.AlchemistsGut.DurationMs = 30000

# Leviathan's Gift: waterbreathing and additive fast swimming.
TertiaryStats.Fabled.LeviathansGift.SwimSpeedPct = 60

# Overkill: excess killing-blow damage and its school bank into your next hit.
TertiaryStats.Fabled.Overkill.WindowMs = 15000

# Blood Magic: missing mana becomes a refreshed damage pool dealing
# HealthPerMana health per missing mana point over DebtDurationMs.
TertiaryStats.Fabled.BloodMagic.HealthPerMana = 4
TertiaryStats.Fabled.BloodMagic.DebtDurationMs = 10000

# Warcaster: casts and channels continue while moving.

# Indomitable: the first hostile hard-control aura each combat fails. Roots,
# snares, silences, disarms, and knockbacks do not consume it.
